# Configuration Nova - Backend (API)

# Environnement (development, staging, production)
APP_ENV=development
DEBUG=false

# PostgreSQL
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova
DATABASE_URL=postgresql://nova:nova@db:5432/nova

# JWT
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CSRF
CSRF_DISABLED=false

# Cookies
# COOKIE_SECURE=true

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Mailhog (SMTP)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@nova.dev

# Seed utilisateur de démonstration
SEED_DEMO_USER=1
DEMO_EMAIL=user@nova.dev
DEMO_PASSWORD=Demo123456789
